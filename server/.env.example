# Server config
# If you're calling this from a phone on the same Wi‑Fi, run uvicorn with --host 0.0.0.0
# Example: uvicorn main:app --host 0.0.0.0 --port 8000 --reload

# Request size guard (bytes)
MAX_IMAGE_BYTES=8388608

# CORS: use '*' for a quick PoC, or a comma-separated list of origins
# Example: CORS_ALLOW_ORIGINS=http://localhost:8081,http://192.168.1.10:8081
CORS_ALLOW_ORIGINS=*

# Detection/tracking
# Uses Ultralytics YOLO (COCO) to detect bottles per-frame and maintains a simple temporal track.
# Install: pip install -r requirements-yolo.txt  (or use Docker; see README/instructions)
DETECTION_BACKEND=yolo
YOLO_MODEL=yolov8n.pt
TARGET_CLASS=bottle
YOLO_CONF=0.35

# Device for inference. Use 'cpu' if you don't have CUDA.
# If you *do* have CUDA, you can try '0' for GPU 0.
YOLO_DEVICE=cpu
